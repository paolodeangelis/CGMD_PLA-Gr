# X-direction
# ------------------------ INITIALIZATION ----------------------------
units        real
boundary     p p p
dimension    3
atom_style   full
pair_style        lj/cut  15.0
bond_style        hybrid morse harmonic table linear 1001
angle_style       hybrid harmonic cosine/squared
dihedral_style    opls
read_data         PLA_rGO_0.1_Equi.data

pair_coeff 1 1 0.0255 7.48 # GO
pair_coeff 2 2 0.128 7.48  # GO
pair_coeff 3 3 0.0797 7.48 # GO
pair_coeff 4 4 0.9553 4.7 # PLA
bond_coeff 1 morse 443.07 1.154 2.86          # GO
bond_coeff 2 table second.table Bond_table2   # GO
bond_coeff 3 table third.table  Bond_table3   # GO
bond_coeff 4 harmonic 9.5538 4.34             # PLA
angle_coeff 1 harmonic 456.61 120             # GO
angle_coeff 2 harmonic 259.47 120             # GO
angle_coeff 3 harmonic 189.93 120             # GO
angle_coeff 4 cosine/squared 14.0919 120      #PLA
dihedral_coeff 1 0 2.075 0 0                  #PLA


pair_modify mix arithmetic

variable        KcaltoJoules    equal   6.95e-21
variable        kB      equal   1.38e-23


timestep        1.0


neighbor          0.3 bin
neigh_modify every 1 delay 0 check yes
thermo_style      custom step etotal temp press vol density
thermo            1000
thermo_modify     flush yes
timestep 	  1.0
fix 1 all npt temp 300 300 100.0 iso 1.0 1.0 1000.0
log                X/log_300
dump              1 all custom 10000 X/PLA_rGO.lammpstrj id type mol x y z
dump_modify 1 sort id
restart 100000    X/PLA-rGO_npt.restart

run               100000

unfix 1
# Thermalization-------------------------------------------------------------------------------------------------------------------

velocity all zero linear

fix 1 all nvt temp 300 300 100
run 100000
restart 100000  X/PLA-rGO_nve.restart
unfix 1

fix 1 all nve

run 100000
unfix	1

reset_timestep 0

# Thermal Conductivity-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

fix nve	all nve	             # time integration is performed under microcanonical ensamble
compute	myKE all ke/atom     # kinetic energy per atom

variable tempperatom atom c_myKE*${KcaltoJoules}/(1.5*${kB})	# temperature per atom

# temperature profile	-----------------

compute	layers all chunk/atom bin/1d x lower 4.0 units box	# group atoms into chunks
fix aveTPA all ave/chunk 100 50 5000 layers v_tempperatom file $c/X/temperature_X.dump     # calculates temperature profile vy average atom temperature within chunks and time

# Muller-Plathé algorithm    -----------------

fix mp all thermal/conductivity	100 x 20     # applies Muller-Plathe algorithm
fix e_exchange all ave/time 100 50 5000 f_mp file X/energy_exchange_X.dump     # cumulative kinetic energy transferred between the bottom and middle of the simulation box (units are kcal/mol)

run	1000000

write_restart X/restartX.lammps
