units        real
boundary     p p p
dimension    3
atom_style   full
pair_style        lj/cut  15.0
bond_style        hybrid morse harmonic table linear 1001
angle_style       hybrid harmonic cosine/squared
dihedral_style    opls

read_data         PLA_rGO_1.0.data

pair_coeff 1 1 0.0255 7.48 # GO
pair_coeff 2 2 0.128 7.48  # GO
pair_coeff 3 3 0.0797 7.48 # GO
pair_coeff 4 4 0.9553 4.7 # PLA
bond_coeff 1 morse 443.07 1.154 2.86          # GO
bond_coeff 2 table second.table Bond_table2   # GO
bond_coeff 3 table third.table  Bond_table3   # GO
bond_coeff 4 harmonic 9.5538 4.34             # PLA
angle_coeff 1 harmonic 456.61 120             # GO
angle_coeff 2 harmonic 259.47 120             # GO
angle_coeff 3 harmonic 189.93 120             # GO
angle_coeff 4 cosine/squared 14.0919 120      #PLA
dihedral_coeff 1 0 2.075 0 0

neighbor          0.3 bin
neigh_modify every 1 delay 0 check yes
thermo_style      custom step etotal temp press vol density
thermo            1000
thermo_modify     flush yes

min_style     cg
min_modify    dmax 0.02
min_modify    line quadratic

minimize          1.0e-4 1.0e-6 100 1000

timestep 	  1.0
#fix 1 all nve
#fix 1 all nvt temp 300.0 300.0 100.0
fix 1 all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000.0
# Dump minimized system



dump              1 all custom 1000 PLA_rGO_1.0.lammpstrj id type mol x y z
dump_modify 1 sort id

restart 10000 PLA.restart

run              1000000

write_data	PLA_rGO_1.0_Equi.data
write_restart   restart.lammps
