# X-direction
# ----------------------- INITIALIZATION ----------------------------

units        	  real
boundary     	  p p p
dimension    	  3
atom_style   	  full

pair_style        lj/cut  15.0
bond_style        hybrid morse harmonic table linear 1001
angle_style       hybrid harmonic cosine/squared
dihedral_style    opls

read_data         PLA_rGO_0.5_Equi.data

pair_coeff 1 1 0.0255 7.48 # GO
pair_coeff 2 2 0.128 7.48  # GO
pair_coeff 3 3 0.0797 7.48 # GO
pair_coeff 4 4 0.9553 4.7 # PLA
bond_coeff 1 morse 443.07 1.154 2.86          # GO
bond_coeff 2 table second.table Bond_table2   # GO
bond_coeff 3 table third.table  Bond_table3   # GO
bond_coeff 4 harmonic 9.5538 4.34             # PLA
angle_coeff 1 harmonic 456.61 120             # GO
angle_coeff 2 harmonic 259.47 120             # GO
angle_coeff 3 harmonic 189.93 120             # GO
angle_coeff 4 cosine/squared 14.0919 120      #PLA
dihedral_coeff 1 0 2.075 0 0                  #PLA


pair_modify mix arithmetic


# ------------------------- SETTINGS ---------------------------------
#### Computes Required
compute csym all centro/atom 12
compute 2 all stress/atom NULL
compute mytemp all temp
compute 11 all reduce sum c_2[1]
compute 12 all reduce sum c_2[2]
compute 13 all reduce sum c_2[3]
compute 14 all reduce sum c_2[4]
compute 15 all reduce sum c_2[5]
compute 16 all reduce sum c_2[6]

neighbor     0.3 bin
neigh_modify delay 10
thermo 1000
velocity all create 100.0 16723
thermo_style custom step temp etotal press pxx pyy pzz lx ly lz

#---------------Energy Equilibriation--------------------------
reset_timestep 0
fix 1 all nve
fix 2 all temp/rescale 10 300.0 300.0 1.0 0.5
dump 1 all custom 10000	X/dump.equilibrate id type x y z

run 100000
unfix 1
unfix 2

#-----------------Pressure Equilibriation-----------------------
fix 1 all npt temp 300.0 300.0 100.0 aniso 0.0 0.0 1000.0 drag 0.3

run 1000000
unfix 1
undump 1

#--------------------Storing Initial length---------------------
variable tmp equal "lx"
variable L0 equal ${tmp}
print "Initial Length, L0: ${L0}"
variable strain equal "v_srate/1e12"

#------------Deform------------------------------
reset_timestep 0
fix 1 all deform 1 x erate 0.000001 units box
fix 2 all nvt temp 300.0 300.0 100.0

variable strain equal "(lx - v_L0)/v_L0"
variable p1 equal "v_strain"
variable p2 equal "-pxx*0.101325"    # in MPa
variable p3 equal "-pyy*0.101325"
variable p4 equal "-pzz*0.101325"
variable p5 equal "lx"
variable p6 equal "ly"
variable p7 equal "lz"
variable p8 equal "temp"
variable p9 equal "pe"
variable p10 equal "ke"
variable p11 equal "-pxy*0.101325"
variable p13 equal "-pyz*0.101325"
variable p12 equal "-pxz*0.101325"
variable fm equal "(v_p2+v_p3+v_p4)/3" ##### Hydrostatic stress

variable fv equal "sqrt((v_p2-v_p3)^2+(v_p3-v_p4)^2+(v_p4-v_p2)^2+6*(v_p11^2+v_p12^2+v_p13^2)/2)" ######Von Mises Stress

variable t equal "v_fm/v_fv"
variable fd equal (((v_p2-v_fm)*(v_p3-v_fm)*(v_p4-v_fm))-v_p11^2*(v_p4-v_fm)-v_p12^2*(v_p3-v_fm)-v_p13^2*(v_p2-v_fm)+2*v_p11*v_p12*v_p13)####Deviatoric Von Mises stress

dump 2 all custom 1000 X/defo.lammpstrj id type x y z c_csym c_2[1] c_2[2] c_2[3] c_2[4] c_2[5] c_2[6]

fix def_print all print 1000 "${p1} ${p2} ${p3} ${p4} ${p5} ${p6} ${p7} ${p8} ${p9} ${p10} ${p11} ${p12} ${p13} ${fm} ${fv} ${t} ${fd}" file X/mg001.defo.txt screen no
run 1000000
