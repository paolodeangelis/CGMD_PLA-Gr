# General parameters
units		  real

atom_style        full
boundary          p p p

pair_style        lj/cut  12.0
bond_style        morse
angle_style       harmonic
dihedral_style    opls

read_data	  Graphene10_10nm.data

#initial velocity----------------------------------------------

#minimize          1.0e-1 1.0e-1 100 1000

variable	KcaltoJoules	equal	6.95e-21
variable	kB	equal	1.38e-23


neighbor          0.3 bin
neigh_modify every 1 delay 0 check yes
thermo_style      custom step etotal temp press vol density
thermo            1000
thermo_modify     flush yes

timestep 	  0.1
fix 1 all npt temp 300 300 100.0 iso 1.0 1.0 1000.0
log   Y/log_300


dump              1 all custom 1000  Y/graphene id type mol x y z
dump_modify 1 sort id

restart 10000  Y/graphene.restart

run               1000

unfix 1
# Thermalization-------------------------------------------------------------------------------------------------------------------

velocity all zero linear

fix 1 all nvt temp 300 300 100
timestep          0.1

run    1000

restart 10000  Y/graphene_nve.restart
unfix 1

fix 1 all nve
timestep          0.1

run 1000
unfix	1

reset_timestep 0

# Thermal Conductivity-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

fix nve	all nve	             # time integration is performed under microcanonical ensamble
compute	myKE all ke/atom     # kinetic energy per atom

variable tempperatom atom c_myKE*${KcaltoJoules}/(1.5*${kB})	# temperature per atom

# temperature profile	-----------------

compute	layers all chunk/atom bin/1d y lower 4.0 units box	# group atoms into chunks
fix aveTPA all ave/chunk 100 50 5000 layers v_tempperatom file Y/temperature_X.dump     # calculates temperature profile vy average atom temperature within chunks and time

# Muller-Plathé algorithm    -----------------

fix mp all thermal/conductivity	100 y 20     # applies Muller-Plathe algorithm
fix e_exchange all ave/time 100 50 5000 f_mp file Y/energy_exchange_Y.dump     # cumulative kinetic energy transferred between the bottom and middle of the simulation box (units are kcal/mol)
timestep          0.1
run	1000000

write_restart Y/restartY.lammps

clear
